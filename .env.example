# Copy to .env and fill in. .env is gitignored; never commit real keys.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
# Needed when the Anthropic key is not scoped to a workspace (the API then returns 400 without it)
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# How Claude Code / Codex agents authenticate:
#   subscription = strip API keys from the agent's environment so `claude` / `codex` use your existing logins
#   api_key      = pass ANTHROPIC_API_KEY to Claude Code and OPENAI_API_KEY (as CODEX_API_KEY) to Codex (billed per token)
AGENT_AUTH=subscription

# Cap on the cumulative billed API spend recorded in logs/spend.jsonl (USD), checked before every LLM call.
# Soft cap: calls already running in parallel can overshoot it slightly; models without a catalog price count as $0.
SPEND_LIMIT_USD=10

# Optional overrides for the agent CLI executables (default: found on PATH via shutil.which)
# CLAUDE_BIN=C:\Users\you\.local\bin\claude.exe
# CODEX_BIN=C:\Users\you\AppData\Local\Programs\OpenAI\Codex\bin\codex.exe

# Where logs and per-run artifacts are written
LOGS_DIR=logs
RUNS_DIR=runs
